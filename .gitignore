# ---------- Dependencies ----------
node_modules/
frontend/node_modules/
backend/node_modules/

# ---------- Environment variables (never commit real secrets) ----------
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# ---------- Build output ----------
frontend/dist/
frontend/build/
frontend/tsconfig.tsbuildinfo

# ---------- Generated files (created at runtime, not source) ----------
backend/receipts/*.pdf
!backend/receipts/.gitkeep

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp

# ---------- Misc ----------
*.local
.cache/
